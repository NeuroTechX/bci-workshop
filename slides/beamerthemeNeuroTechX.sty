\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemeNeuroTechX}[2026/11/26 NeuroTechX 2026-27 presentation theme]

\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{tikz}
\RequirePackage{iftex}
\RequirePackage{etoolbox}

% Theme options:
%   \usetheme{NeuroTechX}             -> 2026-27 warm editorial theme (default)
%   \usetheme[sand]{NeuroTechX}       -> warm stone default canvas (#EDE9E0)
%   \usetheme[dark]{NeuroTechX}       -> dark slate default canvas (#1D2229)
%   \usetheme[legacyblack]{NeuroTechX}-> Sept 2026 black/white theme for archival rebuilds
\newif\ifntx@darkmode
\ntx@darkmodefalse
\newif\ifntx@legacyblack
\ntx@legacyblackfalse
\newif\ifntx@sanddefault
\ntx@sanddefaultfalse

\DeclareOption{light}{\ntx@darkmodefalse\ntx@legacyblackfalse}
\DeclareOption{sand}{\ntx@sanddefaulttrue\ntx@darkmodefalse\ntx@legacyblackfalse}
\DeclareOption{dark}{\ntx@darkmodetrue\ntx@legacyblackfalse}
\DeclareOption{legacyblack}{\ntx@darkmodetrue\ntx@legacyblacktrue}
\ProcessOptions\relax

% Typography: EB Garamond (display serif) + Public Sans (UI/body sans),
% with automatic portable fallbacks (Palatino + TeX Gyre Heros / Latin Modern).
\ifPDFTeX
  \RequirePackage[T1]{fontenc}
  \RequirePackage{lmodern}
  \newcommand{\NTXSerif}{\rmfamily}
  \newcommand{\NTXSans}{\sffamily}
  \newcommand{\NTXTrack}[1]{\MakeUppercase{#1}}
\else
  \RequirePackage{fontspec}
  \IfFontExistsTF{EB Garamond}{%
    \setmainfont{EB Garamond}%
  }{%
    \IfFontExistsTF{Palatino}{%
      \setmainfont{Palatino}%
    }{%
      \setmainfont{Latin Modern Roman}%
    }%
  }
  \IfFontExistsTF{Public Sans}{%
    \setsansfont{Public Sans}%
  }{%
    \setsansfont{texgyreheros-regular.otf}[
      BoldFont=texgyreheros-bold.otf,
      ItalicFont=texgyreheros-italic.otf,
      BoldItalicFont=texgyreheros-bolditalic.otf]%
  }
  \IfFontExistsTF{Menlo}{%
    \setmonofont[Scale=0.86]{Menlo}%
  }{}
  \newcommand{\NTXSerif}{\rmfamily}
  \newcommand{\NTXSans}{\sffamily}
  \newcommand{\NTXTrack}[1]{{\addfontfeature{LetterSpace=14.0}\MakeUppercase{#1}}}
\fi

% Exact 2026-27 NeuroTechX palette (matched to the 2026-27 Intro to NeuroTechX deck)
\definecolor{NTXPaperBase}{HTML}{F7F5F0}
\definecolor{NTXSand}{HTML}{EDE9E0}
\definecolor{NTXTableHead}{HTML}{F1EEE7}
\definecolor{NTXSlate}{HTML}{1D2229}
\definecolor{NTXInkBase}{HTML}{1D2229}
\definecolor{NTXMutedBase}{HTML}{535C67}
\definecolor{NTXMutedOnDark}{HTML}{BCC3CB}
\definecolor{NTXRule}{HTML}{CFC8BA}
\definecolor{NTXDarkRule}{HTML}{454E59}
\definecolor{NTXWatermark}{HTML}{DDD8CC}
\definecolor{NTXTealBase}{HTML}{0B6B70}
\definecolor{NTXTealOnDark}{HTML}{4CC3C9}

\ifntx@legacyblack
  \definecolor{NTXPaper}{HTML}{000000}
  \definecolor{NTXInk}{HTML}{FFFFFF}
  \definecolor{NTXMuted}{HTML}{B8B8B8}
  \definecolor{NTXTeal}{HTML}{B8B8B8}
  \colorlet{NTXRuleActive}{NTXMuted}
\else
  \ifntx@darkmode
    \colorlet{NTXPaper}{NTXSlate}
    \colorlet{NTXInk}{NTXPaperBase}
